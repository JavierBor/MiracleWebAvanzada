# --- Base de Datos PostgreSQL ---
DB_USER=miracle_user
DB_PASSWORD=miracle_password_segura
DB_NAME=miracle_db
DATABASE_URL="postgresql://miracle_user:miracle_password_segura@localhost:5432/miracle_db?schema=public"

# --- Autenticación y Seguridad Interna entre Servicios ---
JWT_SECRET="cambia_esta_clave_jwt_en_produccion"
INTERNAL_API_KEY="miracle_internal_secret_2026"

# --- Control de Tráfico (Rate Limiting en NestJS) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=15